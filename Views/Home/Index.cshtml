                        data-open-service-modal>
                    Request this service
                    <span>→</span>
                </button>
            </article>


            <article class="q4u-service-card">
                <div class="q4u-service-icon">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M12 2 15 8l6 .9-4.5 4.4 1.1 6.2L12 16.6 6.4 19.5l1.1-6.2L3 8.9 9 8l3-6Zm0 4.5-1.7 3.4-3.8.6 2.7 2.7-.6 3.8 3.4-1.8 3.4 1.8-.6-3.8 2.7-2.7-3.8-.6L12 6.5Z" />
                    </svg>
                </div>

                <div class="q4u-service-card-number">
                    03
                </div>

                <h3>Personalised Plates</h3>

                <p>
                    Make your registration more personal with assistance
                    through the personalised plate process.
                </p>

                <button type="button"
                        class="q4u-service-link"
                        data-service="Personalised Plates"
                        data-open-service-modal>
                    Request this service
                    <span>→</span>
                </button>
            </article>


            <article class="q4u-service-card">
                <div class="q4u-service-icon">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 11 7.2 5h9.6L19 11h1a2 2 0 0 1 2 2v5h-2v2h-3v-2H7v2H4v-2H2v-5a2 2 0 0 1 2-2h1Zm2.1 0h9.8l-1.5-4H8.6l-1.5 4ZM5 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm14 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" />
                    </svg>
                </div>

                <div class="q4u-service-card-number">
                    04
                </div>

                <h3>Roadworthy</h3>

                <p>
                    Get support with roadworthy requirements and the
                    documentation needed to keep the process moving.
                </p>

                <button type="button"
                        class="q4u-service-link"
                        data-service="Roadworthy"
                        data-open-service-modal>
                    Request this service
                    <span>→</span>
                </button>
            </article>


            <article class="q4u-service-card">
                <div class="q4u-service-icon">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm0 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm1 3v4.6l3.2 1.9-1 1.7-4.2-2.5V7h2Z" />
                    </svg>
                </div>

                <div class="q4u-service-card-number">
                    05
                </div>

                <h3>Traffic Fines</h3>

                <p>
                    Keep track of traffic fine administration with Q4U
                    assistance and clearer vehicle-related records.
                </p>

                <button type="button"
                        class="q4u-service-link"
                        data-service="Traffic Fines"
                        data-open-service-modal>
                    Request this service
                    <span>→</span>
                </button>
            </article>


            <article class="q4u-service-card">
                <div class="q4u-service-icon">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M3 4h18v6H3V4Zm2 2v2h14V6H5ZM3 12h8v8H3v-8Zm2 2v4h4v-4H5Zm8-2h8v8h-8v-8Zm2 2v4h4v-4h-4Z" />
                    </svg>
                </div>

                <div class="q4u-service-card-number">
                    06
                </div>

                <h3>Fleet Management</h3>

                <p>
                    Bring multiple vehicles, renewals and documents together
                    in a more manageable fleet administration experience.
                </p>

                <button type="button"
                        class="q4u-service-link"
                        data-service="Fleet Management"
                        data-open-service-modal>
                    Request this service
                    <span>→</span>
                </button>
