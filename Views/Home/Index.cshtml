@{
    ViewData["Title"] = "Vehicle Services Made Simple";
}

<section class="q4u-hero">

    <div class="q4u-hero-pattern"></div>
    <div class="q4u-hero-glow q4u-hero-glow-one"></div>
    <div class="q4u-hero-glow q4u-hero-glow-two"></div>

    <div class="container q4u-container q4u-hero-container">

        <div class="q4u-hero-copy">

            <div class="q4u-hero-kicker">
                <span class="q4u-kicker-line"></span>
                YOUR VEHICLE ADMINISTRATION PARTNER
            </div>

            <h1>
                Your vehicle paperwork.
                <span>Sorted.</span>
            </h1>

            <p class="q4u-hero-description">
                Manage renewals, documentation and essential vehicle services
                with the trusted Q4U team — now moving into one simple digital
                experience.
            </p>

            <div class="q4u-hero-actions">
                <button class="q4u-button q4u-button-yellow q4u-button-large"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#serviceRequestModal">
                    Book a Service

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="m13.2 5.3 5.9 5.9c.4.4.4 1 0 1.4l-5.9 5.9-1.4-1.4 4.2-4.2H5v-2h11l-4.2-4.2 1.4-1.4Z" />
                    </svg>
                </button>

                <a href="#platform"
                   class="q4u-hero-secondary-link">
                    Explore the digital platform

                    <span>↓</span>
                </a>
            </div>

            <div class="q4u-hero-trust">
                <div>
                    <strong>35+</strong>
                    <span>Years of experience</span>
                </div>

                <span class="q4u-trust-divider"></span>

                <div>
                    <strong>SABS</strong>
                    <span>Approved plates</span>
                </div>

                <span class="q4u-trust-divider"></span>

                <div>
                    <strong>6</strong>
                    <span>Core vehicle services</span>
                </div>
            </div>
        </div>

        <div class="q4u-hero-visual">

            <div class="q4u-dashboard-preview">

                <div class="q4u-dashboard-preview-header">
                    <div>
                        <span class="q4u-preview-label">
                            MY VEHICLES
                        </span>

                        <h2>Vehicle overview</h2>
                    </div>

                    <div class="q4u-preview-user">
                        AK
                    </div>
                </div>

                <div class="q4u-preview-selector">
                    <label for="heroVehicleSelect">
                        Selected vehicle
                    </label>

                    <select id="heroVehicleSelect"
                            class="form-select">
                        <option value="polo">
                            2021 Volkswagen Polo
                        </option>

                        <option value="hilux">
                            2022 Toyota Hilux
                        </option>

                        <option value="bmw">
                            2020 BMW 320i
                        </option>
                    </select>
                </div>

                <div class="q4u-vehicle-card">

                    <div class="q4u-vehicle-card-top">
                        <div>
                            <span class="q4u-card-label">
                                CURRENT VEHICLE
                            </span>

                            <h3 class="js-vehicle-model">
                                Volkswagen Polo 1.0 TSI
                            </h3>
                        </div>

                        <span class="q4u-status-pill q4u-status-warning js-renewal-status">
                            Action required
                        </span>
                    </div>

                    <div class="q4u-number-plate">
                        <div class="q4u-number-plate-country">
                            ZA
                        </div>

                        <strong class="js-vehicle-plate">
                            JT 42 ZN
                        </strong>

                        <span>GP</span>
                    </div>

                    <div class="q4u-renewal-summary">

                        <div>
                            <span>Licence expiry</span>

                            <strong class="js-renewal-date">
                                28 September 2026
                            </strong>
                        </div>

                        <div class="q4u-renewal-days">
                            <strong class="js-renewal-days">43</strong>
                            <span>days</span>
                        </div>
                    </div>
                </div>

                <div class="q4u-preview-alert">
                    <div class="q4u-preview-alert-icon">
                        !
                    </div>

                    <div>
                        <strong>Renewal reminder</strong>

                        <p class="js-renewal-message">
                            Your licence renewal window is approaching.
                            Q4U can help you prepare.
                        </p>
                    </div>
                </div>

                <div class="q4u-preview-stats">
                    <div>
                        <span class="q4u-preview-stat-icon">
                            ✓
                        </span>

                        <div>
                            <strong>4</strong>
                            <span>Documents</span>
                        </div>
                    </div>

                    <div>
                        <span class="q4u-preview-stat-icon">
                            R
                        </span>

                        <div>
                            <strong>R0.00</strong>
                            <span>Outstanding</span>
                        </div>
                    </div>

                    <div>
                        <span class="q4u-preview-stat-icon">
                            ↗
                        </span>

                        <div>
                            <strong>2</strong>
                            <span>Past services</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="q4u-floating-badge q4u-floating-badge-one">
                <span class="q4u-floating-icon">✓</span>

                <div>
                    <strong>Documents ready</strong>
                    <span>Stored in one place</span>
                </div>
            </div>

            <div class="q4u-floating-badge q4u-floating-badge-two">
                <span class="q4u-floating-icon q4u-floating-icon-yellow">
                    43
                </span>

                <div>
                    <strong>Renewal reminder</strong>
                    <span>Never miss an expiry</span>
                </div>
            </div>
        </div>

    </div>

    <div class="q4u-hero-wave"></div>
</section>


<section class="q4u-brand-strip">
    <div class="container q4u-container">

        <div class="q4u-brand-strip-inner">
            <span>
                LICENCE RENEWALS
            </span>

            <span class="q4u-brand-strip-dot"></span>

            <span>
                NUMBER PLATES
            </span>

            <span class="q4u-brand-strip-dot"></span>

            <span>
                ROADWORTHY
            </span>

            <span class="q4u-brand-strip-dot"></span>

            <span>
                TRAFFIC FINES
            </span>

            <span class="q4u-brand-strip-dot"></span>

            <span>
                FLEET MANAGEMENT
            </span>
        </div>
    </div>
</section>


<section class="q4u-section"
         id="services">

    <div class="container q4u-container">

        <div class="q4u-section-heading q4u-section-heading-centred">
            <span class="q4u-eyebrow">
                WHAT WE DO
            </span>

            <h2>
                Everything your vehicle needs,
                <span>without the runaround.</span>
            </h2>

            <p>
                Q4U brings essential vehicle administration services together
                through one experienced team.
            </p>
        </div>

        <div class="q4u-service-grid">

            <article class="q4u-service-card">
                <div class="q4u-service-icon">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M7 2h10v2h3v18H4V4h3V2Zm2 2h6V3H9v1Zm-3 2v14h12V6h-1v2H7V6H6Zm3 5h6v2H9v-2Zm0 4h6v2H9v-2Z" />
                    </svg>
                </div>

                <div class="q4u-service-card-number">
                    01
                </div>

                <h3>Licence Renewals & Registrations</h3>

                <p>
                    Keep your vehicle paperwork current with guidance and
                    support through the renewal and registration process.
                </p>

                <button type="button"
                        class="q4u-service-link"
                        data-service="Licence Renewal"
                        data-open-service-modal>
                    Request this service
                    <span>→</span>
                </button>
            </article>


            <article class="q4u-service-card q4u-service-card-featured">
                <div class="q4u-featured-tag">
                    WHILE YOU WAIT
                </div>

                <div class="q4u-service-icon">
                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M3 6h18v12H3V6Zm2 2v8h14V8H5Zm2 2h2v4H7v-4Zm4 0h6v2h-6v-2Zm0 3h4v1.5h-4V13Z" />
                    </svg>
                </div>

                <div class="q4u-service-card-number">
                    02
                </div>

