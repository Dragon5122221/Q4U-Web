@model Q4UPrototypeWeb.Models.RequestRecord
@{ Layout=null; }
<!DOCTYPE html><html lang="en-ZA"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Q4U receipt @Model.Reference</title><link rel="stylesheet" href="/css/site.css" /><link rel="stylesheet" href="/css/workspace.css" /></head><body><main class="receipt panel"><span class="eyebrow">ZA NUMBER PLATES Q4U</span><h1>@((bool)ViewBag.Demo ? "DEMO PAYMENT RECEIPT" : "Payment receipt")</h1>@if((bool)ViewBag.Demo){<p><strong>Sample only · No money was charged. Not a tax invoice.</strong></p>}<dl class="definition-list"><dt>Reference</dt><dd>@Model.Reference</dd><dt>Service</dt><dd>@Model.Service</dd><dt>Amount recorded</dt><dd>@Model.Amount.ToString("C2")</dd><dt>Status</dt><dd>Payment recorded</dd></dl><p>Q4U · 011 830 2067</p><div class="actions no-print"><button type="button" class="primary" id="print-receipt">Print / save PDF</button><a class="secondary" href="/Workspace?section=Payments">Back to payments</a></div></main><script src="/js/receipt.js"></script></body></html>
