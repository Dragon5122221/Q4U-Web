@using Q4UPrototypeWeb.Services
@using Q4UPrototypeWeb.Models
@model WorkspacePage
@{
    Layout="_WorkspaceLayout";
    var s=Model.State; var a=Model.Actor; var active=s.Vehicles.Where(v=>!v.Archived).ToList();
    var due=active.Where(v=>v.DaysRemaining<=30).OrderBy(v=>v.Expiry).ToList();
    var open=s.Requests.Where(r=>r.Status is not ("Completed" or "Cancelled")).ToList();
    string Plate(string id)=>s.Vehicles.FirstOrDefault(v=>v.Id==id)?.Registration ?? "Vehicle unavailable";
    string Money(decimal amount)=>amount.ToString("C2",System.Globalization.CultureInfo.GetCultureInfo("en-ZA"));
}
<section class="page-heading"><div><span class="eyebrow">@s.Organisation</span><h1>@(Model.Section switch { "Dashboard"=>"Everything in one place.", "Vehicles"=>"Your vehicle library", "Renewals"=>"Stay ahead of expiry", "Requests"=>"Track your service requests", "Documents"=>"Your documents, organised", "Payments"=>"Quotes & payments", "Fleet"=>"Keep your fleet moving", "Team"=>"Build your team", "Administration"=>"The Q4U work queue", "Developer"=>"Integration centre", "Notifications"=>"Your latest updates", "Settings"=>"Make Q4U work for you", _=>"How can we help?" })</h1></div>
@if(a.Role!="Developer"){<a class="secondary" href="/Workspace/Export">Export my account</a>}</section>
@if(Model.Section=="Dashboard") {
<section class="welcome-band"><div><span class="eyebrow">YOUR NEXT STEP</span><h2>@(due.Count>0 ? "A licence needs your attention." : "You're on top of your vehicle admin.")</h2><p>@(due.Count>0 ? $"{due.Count} vehicle(s) are overdue or expire in the next 30 days. Review the renewal list to get started." : "Add a vehicle, upload supporting documents and request a Q4U service when you need it.")</p><a class="primary" href="/Workspace?section=@(due.Count>0 ? "Renewals" : "Vehicles")">@(due.Count>0 ? "Review renewals" : "Manage vehicles") →</a></div><div class="brand-plate"><small>ZA · Q4U DIGITAL</small><strong>WE QUEUE<br />FOR YOU.</strong></div></section>
<div class="metrics"><a href="/Workspace?section=Vehicles"><strong>@active.Count</strong><span>Active vehicles</span></a><a href="/Workspace?section=Renewals"><strong>@due.Count</strong><span>Due within 30 days</span></a><a href="/Workspace?section=Requests"><strong>@open.Count</strong><span>Open requests</span></a><a href="/Workspace?section=Documents"><strong>@s.Documents.Count(d=>d.Status=="Pending review")</strong><span>Documents to review</span></a></div>
<section class="panel"><div class="section-heading"><h2>Your service journey</h2><a href="/Workspace?section=Help">First time here?</a></div><ol class="journey"><li><a href="/Workspace?section=Vehicles">Add your vehicle</a><span>Registration and expiry date</span></li><li><a href="/Workspace?section=Documents">Upload documents</a><span>Keep supporting files together</span></li><li><a href="/Workspace?section=Requests">Request a service</a><span>Tell us what you need</span></li><li><a href="/Workspace?section=Requests">Track progress</a><span>Follow review through collection</span></li></ol></section>
<section class="panel"><h2>Recent activity</h2>@if(s.Notices.Count==0){<p>No updates yet. Your request progress will appear here.</p>}@foreach(var n in s.Notices.OrderByDescending(n=>n.CreatedAt).Take(5)){<div class="record-line"><span>@n.Message</span><time>@n.CreatedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM, HH:mm")</time></div>}</section>
}
@if(Model.Section is "Vehicles" or "Renewals" or "Fleet") {
<p class="intro">@(Model.Section=="Fleet" ? "Assign drivers and branches, monitor licence expiry and export your vehicle register." : "Keep vehicle details current. Expiry warnings are calculated automatically using South African time.")</p>
<div class="toolbar"><form method="get" class="search-form"><input type="hidden" name="section" value="@Model.Section" /><label for="vehicle-search" class="visually-hidden">Search vehicles</label><input id="vehicle-search" name="q" value="@Model.Query" placeholder="Search registration, driver or model" maxlength="100" /><label for="vehicle-filter" class="visually-hidden">Vehicle filter</label><select id="vehicle-filter" name="filter"><option value="">Active vehicles</option><option value="due" selected="@(Model.Filter=="due")">Due in 30 days / overdue</option><option value="archived" selected="@(Model.Filter=="archived")">Archived</option></select><button class="secondary">Search</button><a href="/Workspace?section=@Model.Section">Clear</a></form><a class="secondary" href="/Workspace/Export?format=csv">Export CSV</a></div>
@if(Model.Section=="Vehicles") {
<details class="panel form-panel" id="add-vehicle"><summary>Add a vehicle <span>+</span></summary><form method="post" action="/Workspace/Command" class="form-grid draft-form">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="vehicle" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Vehicles" /><label>Registration <input name="Value" required maxlength="20" placeholder="e.g. JT 42 ZN GP" /></label><label>Make, model and year <input name="Details" required maxlength="200" placeholder="e.g. Volkswagen Polo · 2021" /></label><label>Licence expiry <input type="date" name="Date" required /></label><p class="field-help">Use the expiry date printed on the licence disc. <button type="button" class="help-dot" data-help="This date drives the renewal reminders. It does not verify the vehicle against a government register." aria-label="About licence expiry">?</button></p><button class="primary">Save vehicle</button></form></details>
}
@if(Model.Section=="Fleet" && active.Count>0){<details class="panel"><summary>Start a batch of licence renewals</summary><p>Select up to 25 vehicles. Each gets its own request and quote. Vehicles with an existing open renewal must be deselected.</p><form method="post" action="/Workspace/Command">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="bulkRenewal" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Fleet" /><div class="form-grid">@foreach(var v in active){<label class="check-label"><input type="checkbox" name="VehicleIds" value="@v.Id" />@v.Registration · @v.Expiry.ToString("dd MMM yyyy")</label>}</div><button class="primary" type="submit">Submit selected renewals</button></form></details>}
var vehicles=s.Vehicles.Where(v=>v.Archived==(Model.Filter=="archived") && (Model.Filter!="due" || v.DaysRemaining<=30) && (Model.Section!="Renewals" || v.DaysRemaining<=60) && $"{v.Registration} {v.Description} {v.Driver} {v.Branch}".Contains(Model.Query,StringComparison.OrdinalIgnoreCase)).OrderBy(v=>v.Expiry).ToList();
@if(vehicles.Count==0){<section class="empty"><h2>No vehicles match this view</h2><p>Clear the search or add your first vehicle from the vehicle library.</p><a class="primary" href="/Workspace?section=Vehicles#add-vehicle">Open vehicle library</a></section>}
@foreach(var v in vehicles) {
<section class="panel vehicle-record"><div class="section-heading"><div><span class="number-plate">@v.Registration</span><h2>@v.Description</h2></div><span class="status @(v.DaysRemaining<=7 ? "danger" : v.DaysRemaining<=30 ? "warning" : "good")">@(v.Archived ? "Archived" : v.DaysRemaining<0 ? $"{Math.Abs(v.DaysRemaining)} days overdue" : $"{v.DaysRemaining} days to expiry")</span></div><div class="record-meta"><span>Licence expiry <strong>@v.Expiry.ToString("dd MMM yyyy")</strong></span><span>Driver <strong>@v.Driver</strong></span><span>Branch <strong>@v.Branch</strong></span><span>Documents <strong>@s.Documents.Count(d=>d.VehicleId==v.Id)</strong></span></div>
<div class="actions">@if(!v.Archived){<a class="primary" href="/Workspace?section=Requests#request-@v.Id">Request a service</a><a class="secondary" href="/Workspace?section=Documents">Documents</a>}
<form method="post" action="/Workspace/Command" data-confirm="@(v.Archived ? "Restore this vehicle to the active library?" : "Archive this vehicle? Its history and documents will remain available.")">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="@Model.Section" /><input type="hidden" name="Action" value="archive" /><input type="hidden" name="Id" value="@v.Id" /><button class="secondary">@(v.Archived ? "Restore" : "Archive")</button></form></div>
@if(!v.Archived){<details class="inline-details"><summary>Edit vehicle details</summary><form method="post" action="/Workspace/Command" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="vehicle" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="@Model.Section" /><input type="hidden" name="Id" value="@v.Id" /><label>Registration<input name="Value" value="@v.Registration" required maxlength="20" /></label><label>Make, model and year<input name="Details" value="@v.Description" required maxlength="200" /></label><label>Licence expiry<input type="date" name="Date" value="@v.Expiry.ToString("yyyy-MM-dd")" required /></label><button class="primary">Save details</button></form></details>}
@if(Model.Section=="Fleet"){<details class="inline-details"><summary>Assign a driver & branch</summary><form method="post" action="/Workspace/Command" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="assignment" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Fleet" /><input type="hidden" name="Id" value="@v.Id" /><label>Driver name<input name="Value" value="@v.Driver" required maxlength="100" /></label><label>Branch<input name="Extra" value="@v.Branch" required maxlength="100" /></label><button class="primary">Save assignment</button></form></details>}
</section>
}
}
@if(Model.Section=="Requests") {
<p class="intro">Submit a request for any active vehicle. Q4U reviews it, prepares a quote and keeps you informed through to completion.</p>
<details class="panel" open><summary>New service request</summary>
@if(active.Count==0){<p>Add an active vehicle before starting a service request.</p><a class="primary" href="/Workspace?section=Vehicles#add-vehicle">Add a vehicle</a>}
@foreach(var v in active){<details class="inline-details" id="request-@v.Id"><summary>@v.Registration · @v.Description</summary><form method="post" action="/Workspace/Command" class="form-grid draft-form">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="request" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Requests" /><input type="hidden" name="Id" value="@v.Id" /><label>Service<select name="Value">@foreach(var item in WorkspaceService.Services){<option>@item</option>}</select></label><label>Fulfilment<select name="Extra"><option>Collection</option><option>Delivery</option></select></label><label class="full">Instructions / delivery address<textarea name="Details" maxlength="1000" rows="3" placeholder="Tell Q4U what you need. For delivery, include the full address."></textarea></label><button class="primary">Submit request</button><p class="field-help">Pricing is confirmed in a quote; submitting does not charge you.</p></form></details>}
</details>
<section class="panel"><h2>Request history</h2><label class="filter-label">Find a request<input data-filter="request-record" placeholder="Search reference, service or status" /></label>@if(s.Requests.Count==0){<p>No requests yet. Choose a vehicle above to start.</p>}
@foreach(var r in s.Requests.OrderByDescending(r=>r.CreatedAt)) {<article class="request-record record-block"><div class="section-heading"><h3>@r.Service · @Plate(r.VehicleId)</h3><span class="status">@r.Status</span></div><p><strong>@r.Reference</strong> · @r.CreatedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy") · @r.Fulfilment</p><p class="preserve-lines">@r.Notes</p><ol class="progress-steps" aria-label="Service stages"><li>Submitted</li><li>Quoted</li><li>Processing</li><li>Ready</li><li>Completed</li></ol><p>Current stage: <strong>@r.Status</strong></p>
@if(!r.Paid && r.Status is "Submitted" or "Quoted"){<form method="post" action="/Workspace/Command" data-confirm="Cancel this service request?">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="cancel" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Requests" /><input type="hidden" name="Id" value="@r.Id" /><button class="secondary">Cancel request</button></form>}
</article>}
<div class="filter-empty" hidden>No requests match your search.</div></section>
}
@if(Model.Section=="Documents") {
<p class="intro">Upload PDF, PNG or JPEG files up to 5 MB. Documents stay linked to a vehicle. Use sample documents while evaluating the prototype.</p>
<details class="panel"><summary>Upload a document</summary><form method="post" action="/Workspace/Upload" enctype="multipart/form-data" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="upload" /><input type="hidden" name="Version" value="@s.Version" /><label>Vehicle<select name="Id" required><option value="">Select a vehicle</option>@foreach(var v in active){<option value="@v.Id">@v.Registration</option>}</select></label><label>Document category<select name="Value"><option>Identity</option><option>Proof of address</option><option>Registration</option><option>Licence disc</option><option>Other</option></select></label><label class="full">File<input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg" required /></label><p class="field-help full">File signatures and size are checked. Files await manual review; automated malware scanning is not connected.</p><button class="primary">Upload for review</button></form></details>
<section class="panel"><h2>Document library</h2>@if(s.Documents.Count==0){<p>No documents uploaded yet. Open “Upload a document” to add one.</p>}
@foreach(var d in s.Documents.OrderByDescending(d=>d.CreatedAt)){<article class="record-block"><div class="section-heading"><h3>@d.FileName</h3><span class="status">@d.Status</span></div><p>@Plate(d.VehicleId) · @d.Category · @((d.Bytes/1024d).ToString("N1")) KB</p>@if(d.ReviewNote!=""){<p>Review note: @d.ReviewNote</p>}<a class="secondary" href="/Workspace/Download?id=@d.Id">Download <span class="visually-hidden">@d.FileName</span></a></article>}</section>
}
@if(Model.Section=="Payments") {
<p class="intro">Review Q4U quotes and download a receipt once payment is recorded. All amounts are in South African rand.</p>
@if(!a.Demo){<div class="feedback">Online payment is not connected yet. Contact Q4U for payment instructions. A payment provider and verified webhook must be integrated before payments can update live records.</div>}
<div class="metrics"><div><strong>@Money(s.Requests.Where(r=>r.Status=="Quoted"&&!r.Paid).Sum(r=>r.Amount))</strong><span>Awaiting payment</span></div><div><strong>@Money(s.Requests.Where(r=>r.Paid).Sum(r=>r.Amount))</strong><span>Recorded payments</span></div></div>
<section class="panel"><h2>Quotes & receipts</h2>@if(!s.Requests.Any(r=>r.Amount>0 && r.Status!="Cancelled")){<p>No quotes yet. Q4U will prepare one after reviewing your request.</p>}
@foreach(var r in s.Requests.Where(r=>r.Amount>0 && r.Status!="Cancelled")){<article class="record-block"><div class="section-heading"><h3>@r.Reference · @r.Service</h3><strong>@Money(r.Amount)</strong></div><p>@Plate(r.VehicleId) · @(r.Paid ? "Payment recorded" : "Awaiting payment")</p>
@if(r.Paid){<a class="secondary" href="/Workspace/Receipt?id=@r.Id">View / print receipt</a>}
else if(a.Demo && a.Role is "Customer" or "FleetOwner"){<form method="post" action="/Workspace/Command" data-confirm="Record a simulated payment? No money will be charged.">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="payDemo" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Payments" /><input type="hidden" name="Id" value="@r.Id" /><button class="primary">Simulate payment</button></form>}
</article>}</section>
}
@if(Model.Section=="Team") {
<p class="intro">Prepare invitations for your organisation. Drafts do not send email or grant access. Live membership provisioning is managed by a trusted administrator.</p>
<section class="panel"><h2>Prepare an invitation</h2><form method="post" action="/Workspace/Command" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="invite" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Team" /><label>Email address<input type="email" name="Value" required maxlength="200" /></label><label>Requested role<select name="Extra"><option value="FleetManager">Fleet manager · operational access</option><option value="Customer">Customer · own records only</option></select></label><button class="primary">Save invitation draft</button></form></section>
<section class="panel"><h2>Invitation drafts</h2>@if(s.Members.Count==0){<p>No invitation drafts yet.</p>}@foreach(var m in s.Members){<div class="record-line"><div><strong>@m.Email</strong><p>@m.Role · @m.Status</p></div><form method="post" action="/Workspace/Command" data-confirm="Remove this invitation draft?">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="removeInvite" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Team" /><input type="hidden" name="Id" value="@m.Id" /><button class="secondary">Remove</button></form></div>}</section>
}
@if(Model.Section=="Administration") {
<p class="intro">Review the current organisation's requests and supporting documents. This profile has no cross-organisation access.</p>
<section class="panel"><h2>Requests awaiting action</h2>@if(open.Count==0){<p>The queue is clear.</p>}
@foreach(var r in open){<article class="record-block"><div class="section-heading"><h3>@r.Reference · @r.Service</h3><span class="status">@r.Status</span></div><p>@Plate(r.VehicleId) · @r.Fulfilment</p><p>@r.Notes</p>
@if(r.Status=="Submitted"){<form method="post" action="/Workspace/Command" class="actions">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="quote" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Administration" /><input type="hidden" name="Id" value="@r.Id" /><label>Quote total (ZAR)<input type="number" name="Amount" min="0.01" max="100000" step="0.01" required /></label><button class="primary">Issue quote</button></form>}
else if(r.Status is "Processing" or "Ready"){<form method="post" action="/Workspace/Command">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="progress" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Administration" /><input type="hidden" name="Id" value="@r.Id" /><input type="hidden" name="Value" value="@(r.Status=="Processing" ? "Ready" : "Completed")" /><button class="primary">Mark @(r.Status=="Processing" ? "ready" : "completed")</button></form>}
else {<p class="field-help">Awaiting payment confirmation.</p>}
</article>}</section>
<section class="panel"><h2>Document review</h2>@if(!s.Documents.Any(d=>d.Status=="Pending review")){<p>No documents awaiting review.</p>}
@foreach(var d in s.Documents.Where(d=>d.Status=="Pending review")){<article class="record-block"><h3>@d.FileName · @Plate(d.VehicleId)</h3><a href="/Workspace/Download?id=@d.Id">Download for review</a><form method="post" action="/Workspace/Command" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="review" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Administration" /><input type="hidden" name="Id" value="@d.Id" /><label>Outcome<select name="Value"><option>Verified</option><option>Rejected</option></select></label><label>Review note (required for rejection)<input name="Details" maxlength="500" /></label><button class="primary">Save review</button></form></article>}</section>
<section class="panel"><h2>Recent audit activity</h2><p class="field-help">Last 200 changes; this prototype log is not an immutable compliance archive.</p>@foreach(var entry in s.Audit.AsEnumerable().Reverse().Take(30)){<div class="record-line"><span>@entry.Action · @entry.Uid</span><time>@entry.CreatedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM HH:mm:ss")</time></div>}</section>
}
@if(Model.Section=="Developer") {
<section class="welcome-band"><div><span class="eyebrow">WEB + FUTURE MOBILE APP</span><h2>One identity. One workspace contract.</h2><p>Use Firebase Authentication UIDs and the versioned Q4U API for shared profiles and records. Developer access does not expose customer records.</p></div></section>
<section class="panel"><h2>Integration status</h2><dl class="definition-list"><dt>Data provider</dt><dd>@(a.Demo ? "Isolated in-memory demonstration" : "Cloud Firestore")</dd><dt>API contract</dt><dd>v1 · schema @s.SchemaVersion</dd><dt>Authentication</dt><dd>@(a.Demo ? "Development profile preview" : "Firebase ID tokens + server-side memberships")</dd><dt>Payments, email & push</dt><dd>Not connected</dd><dt>Mobile app</dt><dd>Planned · consume the API below</dd></dl></section>
<section class="panel"><h2>Available endpoints</h2><div class="table-scroll"><table><thead><tr><th>Method</th><th>Route</th><th>Purpose</th></tr></thead><tbody><tr><td>GET</td><td><code>/api/v1/workspace/me</code></td><td>Verified profile and role</td></tr><tr><td>GET</td><td><code>/api/v1/workspace</code></td><td>Role-filtered records and version</td></tr><tr><td>POST</td><td><code>/api/v1/workspace/commands</code></td><td>Validated, version-checked changes</td></tr></tbody></table></div><p>Send <code>Authorization: Bearer &lt;Firebase ID token&gt;</code>. Demo cookies cannot call this API. See <code>docs/API.md</code> and <code>docs/FIREBASE.md</code> in the project for setup, examples and limits.</p></section>
}
@if(Model.Section=="Notifications") {
<div class="section-heading"><p class="intro">Updates for your profile. These are in-app notices; email, SMS and push are not connected.</p><form method="post" action="/Workspace/Command">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="read" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Notifications" /><input type="hidden" name="Id" value="all" /><button class="secondary">Mark all read</button></form></div>
<section class="panel">@if(s.Notices.Count==0){<h2>You're all caught up</h2><p>Updates will appear as your requests move forward.</p>}@foreach(var n in s.Notices.OrderByDescending(n=>n.CreatedAt)){<article class="record-block"><span class="status">@(n.Read ? "Read" : "Unread")</span><p>@n.Message</p><time>@n.CreatedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm") SAST</time>@if(!n.Read){<form method="post" action="/Workspace/Command">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="read" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Notifications" /><input type="hidden" name="Id" value="@n.Id" /><button class="secondary">Mark read</button></form>}</article>}</section>
}
@if(Model.Section=="Settings") {
<section class="panel"><h2>Profile & contact details</h2><form method="post" action="/Workspace/Command" class="form-grid">@Html.AntiForgeryToken()<input type="hidden" name="Action" value="profile" /><input type="hidden" name="Version" value="@s.Version" /><input type="hidden" name="section" value="Settings" /><label>Display name<input name="Value" value="@Model.Profile.Name" required maxlength="100" autocomplete="name" /></label><label>Phone number<input type="tel" name="Extra" value="@Model.Profile.Phone" maxlength="30" autocomplete="tel" /></label><label class="full">Delivery address<textarea name="Details" maxlength="500" autocomplete="street-address">@Model.Profile.Address</textarea></label><label class="check-label full"><input type="checkbox" name="Id" value="on" checked="@Model.Profile.RenewalReminders" /> Save my preference for renewal reminders (delivery service not connected)</label><button class="primary">Save profile</button></form></section>
<section class="panel" id="accessibility"><span class="eyebrow">YOUR PREFERENCES</span><h2>Accessibility & reading comfort</h2><p>Applied immediately across this website and saved on this browser. These settings do not change other users' preferences.</p><div class="form-grid"><label>Text size<select data-a11y="text"><option value="100">Standard · 100%</option><option value="115">Large · 115%</option><option value="130">Larger · 130%</option><option value="150">Extra large · 150%</option><option value="200">Maximum · 200%</option></select></label><label>Appearance<select data-a11y="theme"><option value="default">Q4U original</option><option value="dark">Dark</option><option value="contrast">High contrast</option></select></label><label class="check-label"><input type="checkbox" data-a11y="motion" /> Reduce motion</label><label class="check-label"><input type="checkbox" data-a11y="spacing" /> Increase reading spacing</label><label class="check-label"><input type="checkbox" data-a11y="links" /> Underline links</label><label class="check-label"><input type="checkbox" data-a11y="focus" /> Extra-visible keyboard focus</label><label class="check-label"><input type="checkbox" data-a11y="targets" /> Larger click / tap targets</label><label class="check-label"><input type="checkbox" data-a11y="simplefont" /> Simple Arial font</label></div><button type="button" class="secondary" id="reset-accessibility">Reset accessibility settings</button><p id="a11y-status" class="field-help" role="status"></p></section>
<section class="panel"><h2>Account security & privacy</h2><p>@(a.Demo ? "This is a demo profile. No password or two-step verification is being changed." : "Your identity is managed by Firebase Authentication. Password recovery is available on the sign-in page; MFA enrolment is not part of this prototype.")</p><p>To request correction or deletion of your information, contact Q4U or submit a Privacy request from Service requests. Deletion is not automatic.</p><div class="actions">@if(a.Role!="Developer"){<a class="secondary" href="/Workspace/Export">Download my data</a>}<a class="secondary" href="/Workspace?section=Help">Contact & support</a></div></section>
}
@if(Model.Section=="Help") {
<section class="welcome-band"><div><span class="eyebrow">START HERE</span><h2>Less searching. More getting things done.</h2><p>Use the navigation to move from vehicles to documents, then services. Every request has a reference and a visible status.</p><a class="primary" href="tel:+27118302067">Call 011 830 2067</a></div></section>
<section class="panel"><h2>Common questions</h2>
<details class="inline-details"><summary>How do I renew a licence?</summary><p>Add the vehicle with its disc expiry date. Upload supporting documents, then open Service requests, choose the vehicle and select Licence renewal. Q4U reviews the request and issues a quote.</p></details>
<details class="inline-details"><summary>What documents do I need?</summary><p>You can organise identity, proof of address, registration and licence-disc documents here. The exact requirements depend on your service and circumstances; Q4U must confirm them before processing.</p></details>
<details class="inline-details"><summary>What can each profile do?</summary><p>Customers manage their own records. Fleet managers work across the assigned organisation's vehicles and requests. Fleet owners also see billing and prepare invitations. Administrators review the organisation's work queue. Developers see integration information without customer records.</p></details>
<details class="inline-details"><summary>Why did my save ask me to refresh?</summary><p>Another tab or user changed the workspace after this page loaded. Refresh to get the latest version, review the change and resubmit. Draft vehicle and request form text is kept for this browser tab until a successful save or sign-out.</p></details>
<details class="inline-details"><summary>Can I use the keyboard and a screen reader?</summary><p>Yes. Tab moves through controls, Enter activates links and buttons, and Space toggles checkboxes. A skip link jumps to the main content. Escape closes confirmation dialogs and help tips. Open Profile & accessibility for text, contrast and motion preferences.</p></details>
<details class="inline-details"><summary>Will the future mobile app share my account?</summary><p>The integration uses the same Firebase UID, organisation membership and API contracts. When connected, both clients can read the same records. Offline editing, push notifications and background syncing still need mobile implementation.</p></details>
<details class="inline-details"><summary>What is simulated?</summary><p>Development profile switching, sample data and payment simulation are for evaluation. Invitation emails, card processing, government verification, SMS, push and scheduled reminders are not connected. Live mode uses Firebase for configured identity, records and documents.</p></details>
</section>
}
